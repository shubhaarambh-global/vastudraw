{
  "name": "ai-vastu-architect",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "contracts:generate": "node scripts/run-project-python.mjs scripts/export-plan-schema.py && pnpm --filter @ai-vastu/contracts exec prettier --write schema/plan-document.schema.json && pnpm --filter @ai-vastu/contracts generate:types",
    "contracts:check": "node scripts/run-project-python.mjs scripts/check-plan-schema.py && pnpm --filter @ai-vastu/contracts check:generated",
    "vastu:check": "node scripts/run-project-python.mjs scripts/check-vastu-spec.py",
    "constraints:check": "node scripts/run-project-python.mjs scripts/check-constraint-compiler.py",
    "planner:check": "node scripts/run-project-python.mjs scripts/check-cp-sat-planner.py",
    "geometry:check": "node scripts/run-project-python.mjs scripts/check-architectural-geometry.py",
    "validation:check": "node scripts/run-project-python.mjs scripts/check-architectural-validation.py",
    "format:check": "pnpm -r --if-present format:check",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "validate": "pnpm python:lint && pnpm python:typecheck && pnpm python:test && pnpm contracts:generate && pnpm contracts:check && pnpm vastu:check && pnpm vastu:review && pnpm vastu:production && pnpm constraints:check && pnpm planner:check && pnpm geometry:check && pnpm validation:check && pnpm scoring:check && pnpm projects:check && pnpm editor:check && pnpm exports:check && pnpm dwg:check && pnpm generation:check && pnpm web-api:check && pnpm project-editor:check && pnpm generation-intake:check && pnpm requirements:check && pnpm confirmed-generation:check && pnpm phase24:check && pnpm phase25:check && pnpm phase26b5:check && pnpm phase26c:check && pnpm billing:check && pnpm saas-ui:check && pnpm persistence:check && pnpm auth:check && pnpm mvp:check && pnpm phase27:check && pnpm phase28:check && pnpm phase29c:check && pnpm phase29d:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm phase26c4a:check && pnpm phase26:check && pnpm phase26:openrouter-check",
    "scoring:check": "node scripts/run-project-python.mjs scripts/check-scoring.py",
    "projects:check": "node scripts/run-project-python.mjs scripts/check-project-revisions.py",
    "editor:check": "pnpm --filter @ai-vastu/web typecheck && pnpm --filter @ai-vastu/web test",
    "exports:check": "node scripts/run-project-python.mjs scripts/check-exports.py",
    "dwg:check": "node scripts/run-project-python.mjs scripts/check-dwg-qualification.py",
    "mvp:check": "node scripts/run-project-python.mjs scripts/check-production-mvp.py",
    "mvp:release": "node scripts/run-project-python.mjs scripts/assert-production-release.py",
    "generation:check": "node scripts/run-project-python.mjs scripts/check-generation-api.py",
    "web-api:check": "node scripts/run-project-python.mjs scripts/check-web-api-workflow.py",
    "persistence:check": "node scripts/run-project-python.mjs scripts/check-production-persistence.py",
    "persistence:live": "node scripts/run-project-python.mjs scripts/check-postgres-live.py",
    "auth:check": "node scripts/run-project-python.mjs scripts/check-auth-authorization.py",
    "auth:live": "node scripts/run-project-python.mjs scripts/check-auth-live.py",
    "project-editor:check": "node scripts/run-project-python.mjs scripts/check-project-editor-workspace.py",
    "vastu:packets": "node scripts/run-project-python.mjs scripts/export-vastu-review-packets.py",
    "vastu:review": "node scripts/run-project-python.mjs scripts/check-vastu-review-candidates.py",
    "vastu:approve": "node scripts/run-project-python.mjs scripts/record-vastu-expert-approval.py",
    "vastu:freeze": "node scripts/run-project-python.mjs scripts/freeze-vastu-spec.py",
    "vastu:production": "node scripts/run-project-python.mjs scripts/check-vastu-production-release.py",
    "saas-ui:check": "node scripts/run-project-python.mjs scripts/check-saas-ui.py",
    "generation-intake:check": "node scripts/run-project-python.mjs scripts/check-generation-intake.py",
    "billing:check": "node scripts/run-project-python.mjs scripts/check-billing-entitlements.py",
    "python:lint": "node scripts/run-project-python.mjs -m ruff check python apps/api tests scripts",
    "python:typecheck": "node scripts/run-project-python.mjs -m mypy",
    "python:test": "node scripts/run-project-python.mjs -m pytest -p pytest_workspace_tmp",
    "requirements:check": "node scripts/run-project-python.mjs scripts/check-requirements-interpreter.py",
    "generation:contract": "node scripts/run-project-python.mjs scripts/inspect-generation-contract.py",
    "confirmed-generation:check": "node scripts/run-project-python.mjs scripts/check-confirmed-generation-binding.py",
    "phase24:contracts": "node scripts/run-project-python.mjs scripts/inspect-phase24-final-contracts.py",
    "phase24:check": "node scripts/run-project-python.mjs scripts/check-phase24-final.py",
    "phase25:check": "node scripts/run-project-python.mjs scripts/check-phase25.py",
    "phase25:launch": "node scripts/run-project-python.mjs scripts/check-production-launch.py",
    "licenses:audit": "node scripts/run-project-python.mjs scripts/audit-third-party.py",
    "phase26b5:check": "node scripts/run-project-python.mjs scripts/check-phase26b5.py",
    "phase26c:check": "node scripts/run-project-python.mjs scripts/check-phase26c.py",
    "phase26c4a:check": "node scripts/run-project-python.mjs scripts/check-phase26c4a.py",
    "phase26:check": "node scripts/run-project-python.mjs scripts/check-phase26-final.py",
    "phase26:openrouter-check": "node scripts/run-project-python.mjs scripts/check-phase26-openrouter.py",
    "phase26:openrouter-live": "node scripts/run-project-python.mjs scripts/check-openrouter-live.py",
    "phase27:check": "node scripts/run-project-python.mjs scripts/check-phase27-final-release.py",
    "phase27:live": "node scripts/run-project-python.mjs scripts/check-phase27-live.py",
    "phase28:check": "node scripts/run-project-python.mjs scripts/check-phase28-hybrid.py",
    "phase28:live": "node scripts/run-project-python.mjs scripts/check-phase28-live.py",
    "phase29c:check": "node scripts/run-project-python.mjs scripts/check-phase29c-hybrid.py",
    "phase29d:check": "node scripts/run-project-python.mjs scripts/check-phase29d-payments.py",
    "phase29c:live": "node scripts/run-project-python.mjs scripts/check-phase29c-live.py",
    "ollama:local": "node scripts/run-project-python.mjs scripts/check-ollama-local.py",
    "apinex:live": "node scripts/run-project-python.mjs scripts/check-apinex-live.py"
  }
}
