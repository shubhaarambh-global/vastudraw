# Phase 29E local advisory-AI profile. Development only.
APP_ENV=development

AI_VASTU_REQUIREMENTS_PROVIDER=ollama_local
AI_VASTU_ARCHITECT_PROVIDER=ollama_local
AI_VASTU_VASTU_PROVIDER=ollama_local
AI_VASTU_ARCHITECTURAL_BRAIN_PROVIDER=ollama_local
AI_VASTU_REVISION_PROVIDER=ollama_local
AI_VASTU_PLAN_RECOGNITION_PROVIDER=ollama_local

AI_VASTU_OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_VASTU_OLLAMA_MODEL=qwen3-vl:8b-instruct-q4_K_M
AI_VASTU_OLLAMA_CONNECT_TIMEOUT_SECONDS=3
AI_VASTU_OLLAMA_READ_TIMEOUT_SECONDS=300
AI_VASTU_OLLAMA_TOTAL_TIMEOUT_SECONDS=360
AI_VASTU_OLLAMA_WRITE_TIMEOUT_SECONDS=30
AI_VASTU_OLLAMA_POOL_TIMEOUT_SECONDS=3

# No provider fallback, API key, model download, or payment setting belongs in
# this profile. Production and staging remain explicitly configured elsewhere.
