APP_ENV=development

# Phase 17 browser/API integration
NEXT_PUBLIC_AI_VASTU_API_BASE_URL=http://127.0.0.1:8000
AI_VASTU_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AI_VASTU_TRUSTED_HOSTS=localhost,127.0.0.1,testserver
# Uvicorn deployment setting, not an application secret. In production set this
# to the exact ingress/sidecar proxy IPs or CIDRs; never use `*`.
# FORWARDED_ALLOW_IPS=127.0.0.1

# Phase 18 production persistence
# Required when APP_ENV=production or APP_ENV=staging.
# Copy the exact PostgreSQL URL from your Supabase/Postgres provider; never commit credentials.
AI_VASTU_DATABASE_URL=
AI_VASTU_DB_POOL_MIN_SIZE=1
AI_VASTU_DB_POOL_MAX_SIZE=10
AI_VASTU_DB_POOL_TIMEOUT_SECONDS=10
# Local/reference adapter only:
AI_VASTU_SQLITE_PATH=:memory:

# Phase 19 authentication / authorization
AI_VASTU_AUTH_MODE=development
AI_VASTU_DEV_BEARER_TOKEN=dev-local-token
AI_VASTU_DEV_USER_ID=11111111-1111-1111-1111-111111111111
AI_VASTU_SUPABASE_URL=
AI_VASTU_SUPABASE_JWT_AUDIENCE=authenticated
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_AI_VASTU_AUTH_MODE=development
NEXT_PUBLIC_AI_VASTU_DEV_BEARER_TOKEN=dev-local-token

# Phase 23 billing
AI_VASTU_BILLING_SQLITE_PATH=.local/billing.sqlite3
# Production must select phonepe, razorpay, or disabled explicitly. PhonePe is
# independent of Razorpay. Secrets remain server-side and must never use a
# NEXT_PUBLIC_ prefix.
AI_VASTU_PAYMENT_GATEWAY=disabled
AI_VASTU_PHONEPE_ENVIRONMENT=sandbox
AI_VASTU_PHONEPE_CLIENT_ID=
AI_VASTU_PHONEPE_CLIENT_SECRET=
AI_VASTU_PHONEPE_CLIENT_VERSION=1
AI_VASTU_PHONEPE_WEBHOOK_USERNAME=
AI_VASTU_PHONEPE_WEBHOOK_PASSWORD=
AI_VASTU_PHONEPE_REDIRECT_URL=http://localhost:3000/billing
AI_VASTU_PHONEPE_CONNECT_TIMEOUT_SECONDS=3
AI_VASTU_PHONEPE_READ_TIMEOUT_SECONDS=10
AI_VASTU_PHONEPE_ORDER_EXPIRE_SECONDS=1200
AI_VASTU_RAZORPAY_KEY_ID=
AI_VASTU_RAZORPAY_KEY_SECRET=
AI_VASTU_RAZORPAY_WEBHOOK_SECRET=
AI_VASTU_RAZORPAY_MONTHLY_PLAN_ID=
AI_VASTU_RAZORPAY_YEARLY_PLAN_ID=

# Phase 24A requirements interpreter storage
AI_VASTU_REQUIREMENTS_PATH=.local/requirement-drafts
AI_VASTU_GENERATION_UPLOAD_ROOT=.local/generation-intakes
OPENAI_API_KEY=
AI_VASTU_OPENAI_MODEL=


# Legacy Gemini adapter, inactive in current Phase 29 profiles and retained only
# for isolated historical regression coverage.
GEMINI_API_KEY=
AI_VASTU_GEMINI_MODEL=gemini-3.1-flash-lite
AI_VASTU_GEMINI_ATTEMPT_TIMEOUT_SECONDS=90
AI_VASTU_GEMINI_TOTAL_TIMEOUT_SECONDS=181
AI_VASTU_GEMINI_RETRY_DELAY_SECONDS=1
AI_VASTU_GEMINI_MAX_RETRY_AFTER_SECONDS=5

# Legacy Phase 26 OpenRouter policy, inactive in current Phase 29 profiles and
# retained only for isolated historical regression coverage.
OPENROUTER_API_KEY=
AI_VASTU_OPENROUTER_PRIMARY_MODEL=deepseek/deepseek-v4-flash-0731:free
AI_VASTU_OPENROUTER_VISION_MODEL=inclusionai/ling-3.0-flash-vl:free
AI_VASTU_OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
AI_VASTU_OPENROUTER_ATTEMPT_TIMEOUT_SECONDS=120
AI_VASTU_OPENROUTER_TOTAL_TIMEOUT_SECONDS=240
AI_VASTU_OPENROUTER_RETRY_DELAY_SECONDS=0
AI_VASTU_OPENROUTER_MAX_RETRY_AFTER_SECONDS=0

# Historical hybrid profile; do not use for the active Phase 29 runtime.
# AI_VASTU_REQUIREMENTS_PROVIDER=openrouter
# AI_VASTU_ARCHITECT_PROVIDER=openrouter
# AI_VASTU_VASTU_PROVIDER=openrouter
# AI_VASTU_ARCHITECTURAL_BRAIN_PROVIDER=openrouter
# AI_VASTU_REVISION_PROVIDER=openrouter
# AI_VASTU_PLAN_RECOGNITION_PROVIDER=gemini
# AI_VASTU_PLAN_RECOGNITION_MODEL=gemini-3.1-flash-lite

# Phase 29 separately configured NVIDIA NIM hosted staging/production-shaped
# profile. The production settings contract pins this exact hosted base URL and
# these exact model IDs. Never place NVIDIA_API_KEY in a tracked file. There is
# no production fallback to Ollama or APINEX.
NVIDIA_API_KEY=
AI_VASTU_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
AI_VASTU_NVIDIA_PRIMARY_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Nemotron 3.5 Lightning is retained only as historical NOT_QUALIFIED_TIMEOUT
# evidence. It is not an active model or automatic production fallback.
AI_VASTU_NVIDIA_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
AI_VASTU_NVIDIA_ATTEMPT_TIMEOUT_SECONDS=120
AI_VASTU_NVIDIA_TOTAL_TIMEOUT_SECONDS=240
AI_VASTU_NVIDIA_RETRY_DELAY_SECONDS=0
AI_VASTU_NVIDIA_MAX_RETRY_AFTER_SECONDS=0
# AI_VASTU_REQUIREMENTS_PROVIDER=nvidia_nim
# AI_VASTU_ARCHITECT_PROVIDER=nvidia_nim
# AI_VASTU_VASTU_PROVIDER=nvidia_nim
# AI_VASTU_ARCHITECTURAL_BRAIN_PROVIDER=nvidia_nim
# AI_VASTU_REVISION_PROVIDER=nvidia_nim
# AI_VASTU_PLAN_RECOGNITION_PROVIDER=nvidia_nim

# Phase 29E qualified local-development default. Keep APP_ENV=development and
# use the dedicated phase29-ollama-local.env.example values as a complete set.
# Local Ollama is never a staging/production fallback.
AI_VASTU_OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_VASTU_OLLAMA_MODEL=qwen3-vl:8b-instruct-q4_K_M
AI_VASTU_OLLAMA_CONNECT_TIMEOUT_SECONDS=3
AI_VASTU_OLLAMA_READ_TIMEOUT_SECONDS=300
AI_VASTU_OLLAMA_TOTAL_TIMEOUT_SECONDS=360
AI_VASTU_OLLAMA_WRITE_TIMEOUT_SECONDS=30
AI_VASTU_OLLAMA_POOL_TIMEOUT_SECONDS=3
AI_VASTU_REQUIREMENTS_PROVIDER=ollama_local
AI_VASTU_ARCHITECT_PROVIDER=ollama_local
AI_VASTU_VASTU_PROVIDER=ollama_local
AI_VASTU_ARCHITECTURAL_BRAIN_PROVIDER=ollama_local
AI_VASTU_REVISION_PROVIDER=ollama_local
AI_VASTU_PLAN_RECOGNITION_PROVIDER=ollama_local

# Phase 29E optional remote development provider. APINEX is NOT_QUALIFIED,
# remains disabled unless explicitly selected, and is rejected outside
# APP_ENV=development.
# Its credential is read only from the operator process environment.
# AI_VASTU_APINEX_BASE_URL=https://api.apinex.bond/v1
# AI_VASTU_APINEX_MODEL=free/gpt-6-luna
# AI_VASTU_APINEX_CONNECT_TIMEOUT_SECONDS=5
# AI_VASTU_APINEX_READ_TIMEOUT_SECONDS=180
# AI_VASTU_APINEX_TOTAL_TIMEOUT_SECONDS=240
# AI_VASTU_APINEX_WRITE_TIMEOUT_SECONDS=30
# AI_VASTU_APINEX_POOL_TIMEOUT_SECONDS=5
# AI_VASTU_REQUIREMENTS_PROVIDER=apinex
# AI_VASTU_ARCHITECT_PROVIDER=apinex
# AI_VASTU_VASTU_PROVIDER=apinex
# AI_VASTU_ARCHITECTURAL_BRAIN_PROVIDER=apinex
# AI_VASTU_REVISION_PROVIDER=apinex
# AI_VASTU_PLAN_RECOGNITION_PROVIDER=apinex

# Production application rate limits. Plan analysis applies only to POST; reads
# and explicit user confirmation are not charged to this scope.
AI_VASTU_RATE_LIMIT_INTERPRET_PER_HOUR=20
AI_VASTU_RATE_LIMIT_GENERATION_PER_HOUR=10
AI_VASTU_RATE_LIMIT_PLAN_ANALYSIS_PER_HOUR=10
AI_VASTU_RATE_LIMIT_CHECKOUT_PER_HOUR=20
AI_VASTU_RATE_LIMIT_PAYMENT_STATUS_PER_HOUR=30
AI_VASTU_RATE_LIMIT_PAYMENT_WEBHOOK_PER_HOUR=240
AI_VASTU_HSTS_SECONDS=31536000

# Local development only. Ignored outside APP_ENV=development.
AI_VASTU_DEV_BILLING_BYPASS=0
